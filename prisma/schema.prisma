generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PLATFORM_ADMIN
  ORG_ADMIN
  SALES_MANAGER
  SALES_REP
  PROJECT_MANAGER
  TEAM_MEMBER
  VIEWER
}
enum Visibility {
  PRIVATE
  SHARED
  PERSONAL
}
enum ActivityKind {
  NOTE
  STAGE_CHANGE
  SYSTEM
}
enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

model User {
  id String @id @default(uuid())
  name String
  email String @unique
  emailVerified Boolean @default(false)
  image String?
  suspended Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions Session[]
  accounts Account[]
  memberships OrganisationMembership[]
  leads Lead[] @relation("LeadOwner")
  notes Note[]
  activities Activity[]
  projects Project[]
  tasks Task[]
  savedViews SavedView[]
  assignedIssues Issue[] @relation("IssueAssignee")
  reportedIssues Issue[] @relation("IssueReporter")
  issueEvents IssueEvent[]
  timeEntries TimeEntry[]
}

model Session {
  id String @id
  expiresAt DateTime
  token String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Account {
  id String @id
  accountId String
  providerId String
  userId String
  accessToken String?
  refreshToken String?
  idToken String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope String?
  password String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Verification {
  id String @id
  identifier String
  value String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([identifier])
}

model Organisation {
  id String @id @default(uuid())
  name String @unique
  slug String @unique
  memberships OrganisationMembership[]
  leads Lead[]
  leadAccess LeadAccess[]
  stages LeadStage[]
  invitations Invitation[]
  projects Project[]
  companies Company[]
  tasks Task[]
}

model OrganisationMembership {
  id String @id @default(uuid())
  userId String
  organisationId String
  role Role
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  @@unique([userId, organisationId])
  @@index([organisationId, role])
}

model Invitation {
  id String @id @default(uuid())
  email String
  tokenHash String @unique
  organisationId String
  role Role
  expiresAt DateTime
  acceptedAt DateTime?
  createdAt DateTime @default(now())
  organisation Organisation @relation(fields: [organisationId], references: [id])
  @@index([email, expiresAt])
}

model LeadStage {
  id String @id @default(uuid())
  name String
  position Int
  organisationId String
  organisation Organisation @relation(fields: [organisationId], references: [id])
  leads Lead[]
  @@unique([organisationId, name])
  @@unique([organisationId, position])
}

model Lead {
  id String @id @default(uuid())
  title String
  companyName String
  email String?
  phone String?
  description String?
  country String @default("Zimbabwe")
  currency String @default("USD")
  estimatedValue Decimal? @db.Decimal(15, 2)
  nextFollowUpAt DateTime?
  visibility Visibility @default(PRIVATE)
  organisationId String
  ownerId String
  stageId String
  projectId String?
  companyId String?
  expectedCloseAt DateTime?
  stageChangedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  organisation Organisation @relation(fields: [organisationId], references: [id])
  owner User @relation("LeadOwner", fields: [ownerId], references: [id])
  stage LeadStage @relation(fields: [stageId], references: [id])
  project Project? @relation(fields: [projectId], references: [id])
  company Company? @relation(fields: [companyId], references: [id])
  tasks Task[]
  quotes Quote[]
  access LeadAccess[]
  notes Note[]
  activities Activity[]
  @@index([organisationId, deletedAt, updatedAt])
  @@index([ownerId, deletedAt])
  @@index([stageId, deletedAt])
}

model LeadAccess {
  leadId String
  organisationId String
  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  @@id([leadId, organisationId])
  @@index([organisationId])
}

model Note {
  id String @id @default(uuid())
  body String
  leadId String
  authorId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lead Lead @relation(fields: [leadId], references: [id])
  author User @relation(fields: [authorId], references: [id])
  @@index([leadId, createdAt])
}

model Activity {
  id String @id @default(uuid())
  kind ActivityKind
  description String
  leadId String
  actorId String
  createdAt DateTime @default(now())
  lead Lead @relation(fields: [leadId], references: [id])
  actor User @relation(fields: [actorId], references: [id])
  @@index([leadId, createdAt])
}

model Project {
  id String @id @default(uuid())
  name String
  emoji String?
  description String?
  status ProjectStatus @default(PLANNING)
  organisationId String
  ownerId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  organisation Organisation @relation(fields: [organisationId], references: [id])
  owner User @relation(fields: [ownerId], references: [id])
  leads Lead[]
  quotes Quote[]
  issues Issue[]
  @@index([organisationId, deletedAt, updatedAt])
  @@index([ownerId, deletedAt])
}

model AiConfiguration {
  id String @id
  encryptedKey String?
  model String @default("deepseek-flash")
  enabled Boolean @default(false)
  updatedAt DateTime @updatedAt
}
model AiRateLimit {
  userId String @id
  lastRequestedAt DateTime
}


enum QuoteStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  CONVERTED
}

model Company {
  id String @id @default(uuid())
  name String
  website String?
  industry String?
  description String?
  organisationId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organisation Organisation @relation(fields: [organisationId], references: [id])
  contacts Contact[]
  leads Lead[]
  @@index([organisationId, name])
}

model Contact {
  id String @id @default(uuid())
  name String
  jobTitle String?
  email String?
  phone String?
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  @@index([companyId])
}

model Task {
  id String @id @default(uuid())
  title String
  description String?
  dueAt DateTime
  priority String @default("NORMAL")
  completedAt DateTime?
  assigneeId String
  leadId String?
  organisationId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  assignee User @relation(fields: [assigneeId], references: [id])
  lead Lead? @relation(fields: [leadId], references: [id])
  organisation Organisation? @relation(fields: [organisationId], references: [id])
  timeEntries TimeEntry[]
  @@index([assigneeId, completedAt, dueAt])
  @@index([leadId])
}

model Quote {
  id String @id @default(uuid())
  number Int @unique @default(autoincrement())
  title String
  status QuoteStatus @default(DRAFT)
  currency String @default("USD")
  taxRate Decimal @default(0) @db.Decimal(5, 2)
  notes String?
  validUntil DateTime
  leadId String
  projectId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lead Lead @relation(fields: [leadId], references: [id])
  project Project? @relation(fields: [projectId], references: [id])
  items QuoteItem[]
  @@index([leadId, status])
}

model QuoteItem {
  id String @id @default(uuid())
  quoteId String
  description String
  quantity Decimal @db.Decimal(12, 2)
  unitPrice Decimal @db.Decimal(15, 2)
  position Int
  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  @@index([quoteId, position])
}

model SavedView {
  id String @id @default(uuid())
  name String
  userId String
  filters Json
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}


enum IssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}
model Issue {
  id String @id @default(uuid())
  title String
  description String
  priority String @default("NORMAL")
  status IssueStatus @default(OPEN)
  resolution String?
  resolvedAt DateTime?
  projectId String
  assigneeId String
  reporterId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project Project @relation(fields: [projectId], references: [id])
  assignee User @relation("IssueAssignee", fields: [assigneeId], references: [id])
  reporter User @relation("IssueReporter", fields: [reporterId], references: [id])
  events IssueEvent[]
  timeEntries TimeEntry[]
  @@index([projectId, status])
  @@index([assigneeId, status])
}
model IssueEvent {
  id String @id @default(uuid())
  issueId String
  actorId String
  description String
  createdAt DateTime @default(now())
  issue Issue @relation(fields: [issueId], references: [id])
  actor User @relation(fields: [actorId], references: [id])
  @@index([issueId, createdAt])
}
model TimeEntry {
  id String @id @default(uuid())
  userId String
  taskId String?
  issueId String?
  startedAt DateTime @default(now())
  stoppedAt DateTime?
  user User @relation(fields: [userId], references: [id])
  task Task? @relation(fields: [taskId], references: [id])
  issue Issue? @relation(fields: [issueId], references: [id])
  @@index([taskId])
  @@index([issueId])
  @@index([userId, stoppedAt])
}
